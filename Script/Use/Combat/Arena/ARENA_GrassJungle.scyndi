Module

#use "libs/sci/sys"
#use "libs/sci/graphics"

#use "Script/Flow/FlowCombat/Quake"

plua ImgTree  = LoadNewImage("gfx/textures/grassjungle/Animated grass.jpbf","ARENA_GrassJungle_Grass_ANIGRASS")
plua ImgGrass = LoadNewImage("GFX/Textures/road/Dead Grass.png","ARENA_GrassJungle_Grass_FLOOR") 

plua Trees

init
	ImgTree.Hot(ImgTree.Width div 2, ImgTree.Height)
End

Class ARENA_GrassJungle_Grass
	static int i
	int X
	int Y
	readonly int spd
	int skip = 0
	int frame = 0
	Constructor
		X = i
		i = i + math.random(1,3)
		Y = (Graphics.Height div 4) + math.random(-50,5)
		spd = math.random(1,10)
	end
end


Void StartCombat()
	plua Temp = {}
	plua NewTree
	Trees = {}
	ARENA_GrassJungle_Grass.i = -32
	Repeat
		NewTree = New ARENA_GrassJungle_Grass()
		Temp[sprintf("%04d::%04d",NewTree.Y,NewTree.X)] = NewTree
	LoopWhile ARENA_GrassJungle_Grass.i < Graphics.Width+32
	for _,tree in spairs(Temp)
		Trees[len(Trees)] = tree
	end
End

Void Draw()
	SetColor(0,180,255)
	Rect(0,0,Graphics.Width,Graphics.Height)
	SetColor(255,255,255)
	ImgGrass.Tile(0,(graphics.height div 4)-55,graphics.width,(graphics.height div 2)+90)
	For tree in Each(Trees)
		ImgTree.Draw(tree.x+Quake.X,tree.y+Quake.Y,tree.frame)
		tree.skip = (tree.skip + 1) % math.max(1,tree.spd)
		If tree.skip==0
			tree.frame = (tree.frame + 1) % 180
		End
	End
End
