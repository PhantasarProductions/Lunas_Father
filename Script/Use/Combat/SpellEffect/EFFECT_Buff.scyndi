Module

#use "Libs/SCI/SString"

#use "Script/Use/Link/Mini"
#use "Script/Use/Link/Party"


// Will take on all targets in once (I need this for Rachel's blunderbus
// but perhaps some other effects are possible here too.
// This is void, as returning values won't work on multiple targets.
// Effect script will have to denote misses by itself.
Void WideEffect(Executor,Targets,String Param)
End


// Effect for single target (when there are multiple targets this function
// will be called once for each target). 'True' denotes the effect was 
// succesful and 'False' will denote a miss.
Bool Effect(Executor,Target,String RawParam)
	Params:=XSplit(RawParam," ")
	String BStat:=Params[0]
	Int Procent:=lua.tonumber(Params[1]) || 25
	Int Base:=Target.Char.Stat[BStat].Base
	Int Buff:=math.ceil(math.abs(Base*(Procent*0.01)))
	If Procent>0 && Buff>Target.Char.XStat[BStat].Buff
		Target.Char.XStat[BStat].Buff = Buff
		Mini.Write(Target.Name,255,180,0)
		Mini.Write(Ternary(Suffixed(Upper(Target.Name),"s"),"' ","'s "),180,255,0)
		Mini.Write(BStat,255,255,255)
		Mini.Write(" has been increased by ",180,255,0)
		Mini.WriteLn(sprintf("%d",Buff),0,180,255)
		Return True
	ElIf Procent<0 && (0-Buff)<Target.Char.XStat[BStat].Buff
		Target.Char.XStat[BStat].Buff = 0-Buff
		Mini.Write(Target.Name,255,75,75)
		Mini.Write(Ternary(Suffixed(Upper(Target.Name),"s"),"' ","'s "),180,255,0)
		Mini.Write(BStat,255,255,255)
		Mini.Write(" has been decreased by ",180,255,0)
		Mini.WriteLn(sprintf("%d",Buff),0,180,255)
		Return True
	End		
	Return False
End
