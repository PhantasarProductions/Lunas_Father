Module

#use "Libs/SCI/Sys"
#use "Libs/SCI/InterVar"
#use "Script/Use/Link/Mini"
#use "Script/Use/Link/Party"
#use "Script/Use/General/Dice"
#use "Script/Use/General/UseIAA"
#use "Script/Flow/FlowCombat/CharMsg"

Bool Effect(Executor,Target,String Param)
	Int RollEx := math.random(1,Executor.Char.Stat.Agility*(4-gint.skill))
	Int RollTt := math.random(1,Target.Char.Stat.Agility*gint.skill)
	CSayF("Stealing roll: %4d; Defending roll: %4d",RollEx,RollTt) 
	If RollEx<RollTt
		CSayF("Main roll failed! Nothing stolen!")
		Return False
	End
	Lua.assert(Target.Team=="Foe","Stealing from hero doesn't work for this script! >> "..Target.Tag)
	If Target.StolenFrom
		CSayF("%s has already been stolen from, so not gonna allow another steal",Target.StolenFrom)
		Return False
	End
	If Dice.D100>Target.RawData.IntValue("STEAL","RATE")
		CSay("Steal roll for % failed! Nothing stolen!")
		Return False
	End
	itag:=Target.RawData.Value("Steal","Item")
	If iaa[itag].Give()
		Mini.Write(Executor.Name,255,180,0)
		Mini.Write(" stole ",180,0,255)
		Mini.WriteLn(iaa[itag].Name,0,180,255)
		Target.StolenFrom = true
		Return True
	End
	CSayF("%s could not be given! Inventory slot full?",itag)
	Return False
End
