// Data for Credits Roll!

// 26 Aug 2026; 23:42:00

Module CD_1787780520

#use "Libs/SCI/Sys"
#use "Libs/SCI/Graphics"


Class DCC
	ReadOnly String Caption
	ReadOnly Int RGB_HSV
	ReadOnly Int R
	ReadOnly Int G
	ReadOnly Int B
	ReadOnly Number Hue
	ReadOnly Number Sat
	ReadOnly Var Img
	ReadOnly Number Val
	ReadOnly Int InitY
	Int Y
	Static Int Cnt


	static Void WL()
		Cnt++
	End


	Constructor(String Cap,Int RH=1,V1,V2,V3)
		Caption=Cap
		RGB_HSV=Ternary(RH==2 || RH==3,RH,1)
		CSayF("Adding: %d.%s",RGB_HSV,Cap)
		Switch RGB_HSV
			Case 1; R,G,B = V1 || 255,V2 || 255,V3 || 255
			Case 2; Hue,Sat,Val = V1 || 0,V2 || 0,V3 || 1
			Case 3; Img = Lua.Scyndi.Globals.LoadNewImage(Cap,"CREDITS::"..Cap)
		End
		InitY = Graphics.Height+(Cnt*30); Y = InitY
		Cnt++
		If RGB_HSV==3
			Cnt+=Img.Height Div 30
			Img.HotCenter()
		End
	End
End

Global Var DataCredits

Init
	DC:={}
	DataCredits=DC

	DC+=New DCC("GFX/Algemeen/Logo.png",3)
	DC+=New DCC("A game developed by:")
	DC+=New DCC("Jeroen P. Broks",1,255,180,0)
