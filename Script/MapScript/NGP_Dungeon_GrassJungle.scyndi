Script

#use "Libs/SCI/Sys"
#use "Libs/SCI/Audio"
#use "Libs/SCI/Intervar"

#use "Script/Use/Link/Map"
#use "Script/Use/Link/Ach"
#use "Script/Use/Link/Alchemy"

Init
	CSay("Groen is gras, groen is gras, onder mijne voeten")
	CSay("'k Heb verloren, 'k heb verloren, waar zal ik 't zoeken")
	CSay("Hee daar, plaats gemaakt, voor de jongedame")
	CSay("Hoor de koekoek op 't dak")
	CSay("Zingt zijn lied op zijn gemak")
	CSay("O, mijn lieve Augustijn")
	CSay("Deze dame zal 't zijn.")
End


Global Void Remove_Barrier()
	Map.PermaKill("Barrier")
End

Const Global Delegate NPC_Cauldron = GoAlchemy


Global Void ZA_Boss()
	Map.Boss("Boss")
	Map.Schedule("PS_Boss")
End

Global Void PS_Boss()
	gint.LevelCap = gint.LevelCap + (3-gint.skill) + (6-gint.skill)
	Map.PermaKill("ZA_Boss")
	Map.PermaKill("Boss")
End

Global Void NPC_Heks()
	Awarded.ZZ_NEWGAME_PLUS_DRUM = true
	Map.GotoMap("CH2_Town_Independence","Beach","From_Grass")
	Lach:=Audio.LoadNew("Audio/wlaugh.mp3","HEKSENLACH")	
	Lach.Play()	
End
