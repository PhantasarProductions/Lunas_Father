Script

#use "Libs/SCI/Sys"
#use "Libs/SCI/Graphics"

#use "Script/Use/Data/DataCredits"

Plua Fnt = ObtainFont("BASE")
plua DebugCall = False

Global Void Reset()
	For DC in EacH(DataCredits)
		DC.Y=DC.InitY
	End
End

Global Void CallDebug()
	DebugCall = True
End

Global Void MainFlow()
	Klaar:=true
	For DC in Each(DataCredits)
		Klaar = Klaar && DC.Y<-100
		If DC.Y>-40 && DC.Y<Graphics.Height+40
			Switch DC.RGB_HSV
				Case 1
					SetColor(DC.R,DC.G,DC.B)
					Fnt.Text(DC.Caption,Graphics.Width div 2,DC.Y,2,2)
				Case 2
					SetColorHSV(DC.Hue,DC.Sat,DC.Val)
					Fnt.Text(DC.Caption,Graphics.Width div 2,DC.Y,2,2)
				Case 3
					SetColor(255,255,255)
					DC.Img.Draw(Graphics.Width div 2, DC.Y)
			End
		End
		DC.Y--
	End
	If Klaar
		if DebugCall
			DebugCall = False
			Sys.CurrentFlow = "FIELD"
		Else
			Lua.error("End of credits not yet scripted")
		End
	End
End
